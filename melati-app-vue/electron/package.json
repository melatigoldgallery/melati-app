{
  "name": "melati-electron-shell",
  "version": "1.0.0",
  "description": "Desktop shell for Melati App with native printing integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist-linux": "electron-builder --linux"
  },
  "dependencies": {
    "bwip-js": "^4.2.0",
    "handlebars": "^4.7.8",
    "loudness": "^0.4.2"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.melatigoldgallery.melatiapp",
    "productName": "Melati App",
    "compression": "maximum",
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "templates/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/ico.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Utility",
      "icon": "assets/png.png"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3"
      ]
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/loudness/**/*"
    ]
  }
}
