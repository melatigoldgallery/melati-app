rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isPrivileged() {
      return hasRole('admin') || hasRole('hrd') || hasRole('supervisor');
    }

    // Floor-scoped storage paths (multi-floor rollout)
    // Servis uploads now use global paths (data is global)

    match /floors/{floorId}/order-online/proof/{orderNo}/{docId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    match /floors/{floorId}/promotions/{year}/{month}/{contentType}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('video/.*')
                     || request.resource.contentType == 'application/octet-stream'
                   );
      allow delete: if isAuthenticated();
    }

    // Rules for manual sales photo uploads
    match /floors/{floorId}/manual-sales/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }

    // Rules for global store services (layanan toko) - needed by LayananTokoView.vue
    match /layanan/{category}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 3 * 1024 * 1024 // Max 3MB
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated();
    }



    // Medical Certificate Rules (Phase 1 - Cloudinary → Firebase Migration)
    // Path structure: medical-certificates/{year}/{month}/{employeeId}_{timestamp}_{uuid}.{ext}
    match /medical-certificates/{year}/{month}/{fileName} {
      // Allow employees to read/download their own certificates
      allow read: if isAuthenticated()
                  && (
                    resource.metadata.uploadedBy == request.auth.uid
                    || resource.metadata.employeeId == request.auth.uid
                    || fileName.matches('.*' + request.auth.uid + '.*')
                    || isPrivileged()
                  );
      
      // Allow employees to upload only their own certificates
      allow write: if isAuthenticated()
                   && request.resource.metadata.uploadedBy == request.auth.uid
                   && request.resource.size < 2 * 1024 * 1024 // Max 2MB
                   && request.resource.contentType in ['image/jpeg', 'image/jpg', 'image/png', 'application/pdf'];
      
      // Only admin/hrd can delete medical certificates
      allow delete: if isAuthenticated() && (hasRole('admin') || hasRole('hrd'));
    }

    // Rules for bukti-pengambilan folder (existing service photos)
    match /bukti-pengambilan/{year}/{month}/{fileName} {
      // Allow authenticated users to read (more secure than public read)
      allow read: if isAuthenticated();

      // Allow authenticated users to write (upload)
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*'); // Images only

      // Allow authenticated users to delete
      allow delete: if isAuthenticated();
    }

    // Rules for bukti-pengambilan-lite folder (compressed service pickup photos)
    match /bukti-pengambilan-lite/{year}/{month}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*'); // Images only

      allow delete: if isAuthenticated();
    }

    // Rules for bukti-penerimaan-servis folder (service receiving photos)
    match /bukti-penerimaan-servis/{year}/{month}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*'); // Images only

      allow delete: if isAuthenticated();
    }

    // Rules for bukti-penerimaan-servis-lite folder (compressed service receiving photos)
    match /bukti-penerimaan-servis-lite/{year}/{month}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024 // Max 5MB
                   && request.resource.contentType.matches('image/.*'); // Images only

      allow delete: if isAuthenticated();
    }

    // Rules for order online proof uploads
    // Path structure: order-online/proof/{orderNo}/{docId}/{timestamp}-{fileName}
    match /order-online/proof/{orderNo}/{docId}/{fileName} {
      allow read: if isAuthenticated();

      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if isAuthenticated();
    }

    // Rules for promotions folder (admin promosi uploads)
    // Path structure: promotions/{year}/{month}/{contentType}/{fileName}
    match /promotions/{year}/{month}/{contentType}/{fileName} {
      // Admin pages are authenticated; allow signed URL generation and management
      allow read: if isAuthenticated();

      // Allow authenticated uploads for image/video content
      allow write: if isAuthenticated()
                   && request.resource.size < 50 * 1024 * 1024 // Max 50MB for video promo
                   && (
                     request.resource.contentType.matches('image/.*')
                     || request.resource.contentType.matches('video/.*')
                     || request.resource.contentType == 'application/octet-stream'
                   );

      // Allow authenticated delete (used by admin panel cleanup)
      allow delete: if isAuthenticated();
    }

    // Deny all other paths by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
